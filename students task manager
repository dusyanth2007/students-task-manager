<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>STUDYFLOW – Student Task Manager</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#090d18;--panel:rgba(18,24,40,.78);--panel2:#11182a;--border:rgba(255,255,255,.09);
  --text:#f4f7fb;--muted:#8e9ab0;--primary:#7c5cff;--primary2:#9a83ff;--green:#35d39a;
  --yellow:#f7c948;--red:#ff647c;--blue:#55a8ff;--shadow:0 18px 50px rgba(0,0,0,.28)
}
body{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:
radial-gradient(circle at 15% 10%,rgba(124,92,255,.16),transparent 28%),radial-gradient(circle at 85% 80%,rgba(53,211,154,.08),transparent 25%),var(--bg);
color:var(--text);min-height:100vh}
button,input,select,textarea{font:inherit}
button{cursor:pointer;border:0}
.app{display:flex;min-height:100vh}
.sidebar{width:250px;position:fixed;left:0;top:0;bottom:0;padding:25px 17px;background:rgba(10,14,27,.9);border-right:1px solid var(--border);backdrop-filter:blur(18px);z-index:20}
.logo{display:flex;gap:11px;align-items:center;padding:5px 10px 28px;font-weight:800;font-size:20px}
.logo-mark{width:38px;height:38px;border-radius:12px;background:linear-gradient(135deg,var(--primary),#43d8b0);display:grid;place-items:center;font-size:19px;box-shadow:0 8px 25px rgba(124,92,255,.3)}
.tagline{font-size:11px;color:var(--muted);font-weight:500;margin-top:-22px;margin-left:59px;margin-bottom:25px}
.nav{display:grid;gap:6px}.nav button{background:transparent;color:var(--muted);padding:12px 13px;border-radius:12px;text-align:left;display:flex;align-items:center;gap:12px;font-weight:600;transition:.2s}
.nav button:hover,.nav button.active{background:rgba(124,92,255,.13);color:#fff}
.nav .ico{width:20px;text-align:center}
.side-bottom{position:absolute;bottom:20px;left:17px;right:17px}
.user-mini{display:flex;gap:10px;align-items:center;padding:12px;border:1px solid var(--border);border-radius:15px;background:rgba(255,255,255,.03)}
.avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#6f54ef,#35cfa0);font-weight:800}
.user-mini small{color:var(--muted);display:block;max-width:145px;overflow:hidden;text-overflow:ellipsis}
.main{margin-left:250px;width:calc(100% - 250px);padding:26px 30px 50px}
.mobile-top{display:none}.page{display:none;animation:fade .25s ease}.page.active{display:block}
@keyframes fade{from{opacity:.5;transform:translateY(3px)}to{opacity:1;transform:none}}
.topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:25px}
.topbar h1{font-size:28px}.topbar p{color:var(--muted);font-size:14px;margin-top:4px}
.primary{background:linear-gradient(135deg,var(--primary),#5e7cff);color:#fff;padding:11px 16px;border-radius:11px;font-weight:700;box-shadow:0 10px 25px rgba(124,92,255,.22);transition:.2s}
.primary:hover{transform:translateY(-1px);filter:brightness(1.08)}
.ghost{background:rgba(255,255,255,.05);border:1px solid var(--border);color:#dbe2ee;padding:10px 14px;border-radius:10px}
.danger{color:#ff8294!important}.icon-btn{background:transparent;color:var(--muted);padding:6px;border-radius:8px}.icon-btn:hover{background:rgba(255,255,255,.08);color:white}
.grid{display:grid;gap:15px}.stats{grid-template-columns:repeat(5,1fr)}
.card{background:var(--panel);border:1px solid var(--border);border-radius:17px;box-shadow:var(--shadow);backdrop-filter:blur(14px)}
.stat{padding:19px}.stat-top{display:flex;justify-content:space-between;color:var(--muted);font-size:12px;font-weight:700}.stat-num{font-size:28px;font-weight:800;margin-top:12px}.stat-icon{width:32px;height:32px;border-radius:9px;display:grid;place-items:center;background:rgba(124,92,255,.13);color:#ad9cff}
.dashboard-grid{grid-template-columns:1.4fr 1fr;margin-top:15px}.section{padding:20px}.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:17px}.section h2{font-size:16px}.muted{color:var(--muted);font-size:13px}
.progress-box{display:flex;align-items:center;gap:25px}.ring{width:105px;height:105px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--primary) 0deg,var(--primary) 0deg,rgba(255,255,255,.07) 0deg);position:relative;flex:none}.ring:after{content:"";position:absolute;width:79px;height:79px;border-radius:50%;background:#121829}.ring span{z-index:1;font-size:20px;font-weight:800}.legend{display:grid;gap:11px;width:100%}.legend-row{display:flex;justify-content:space-between;font-size:13px}.dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:7px}
.task-item{padding:13px 0;border-bottom:1px solid rgba(255,255,255,.06);display:flex;align-items:center;justify-content:space-between;gap:12px}.task-item:last-child{border-bottom:0}.task-title{font-weight:700;font-size:13px}.task-sub{color:var(--muted);font-size:11px;margin-top:4px}.task-left{min-width:0}.task-title,.task-sub{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.badge{display:inline-flex;padding:4px 8px;border-radius:999px;font-size:10px;font-weight:800}.high{color:#ff8093;background:rgba(255,100,124,.12)}.medium{color:#ffd96a;background:rgba(247,201,72,.11)}.low{color:#67e4b3;background:rgba(53,211,154,.1)}
.status{color:#aeb8cb;background:rgba(255,255,255,.07)}.completed{color:#67e4b3;background:rgba(53,211,154,.1)}.progress{color:#74b9ff;background:rgba(85,168,255,.1)}
.overdue{color:#ff7188;background:rgba(255,100,124,.1)}
.toolbar{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:15px}.search{flex:1;min-width:220px}.input,.select,.textarea{width:100%;background:rgba(255,255,255,.045);border:1px solid var(--border);outline:none;color:#fff;padding:11px 12px;border-radius:10px}.textarea{resize:vertical;min-height:80px}.input:focus,.select:focus,.textarea:focus{border-color:rgba(124,92,255,.7);box-shadow:0 0 0 3px rgba(124,92,255,.1)}.select{min-width:130px}.select option{background:#11182a}
.table-wrap{overflow:auto}.task-table{width:100%;border-collapse:collapse;min-width:750px}.task-table th{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.05em;text-align:left;padding:12px;border-bottom:1px solid var(--border)}.task-table td{padding:14px 12px;border-bottom:1px solid rgba(255,255,255,.055);font-size:13px}.task-table tr:hover{background:rgba(255,255,255,.025)}.actions{display:flex;gap:4px}
.empty{text-align:center;padding:50px 20px;color:var(--muted)}.empty .empty-icon{font-size:38px;margin-bottom:12px}.empty h3{color:#e9edf5;margin-bottom:6px}
.subject-grid{grid-template-columns:repeat(3,1fr)}.subject-card{padding:18px}.subject-title{display:flex;justify-content:space-between;align-items:center}.subject-title h3{font-size:16px}.subject-stats{display:flex;gap:20px;margin:18px 0}.subject-stat strong{font-size:19px;display:block}.subject-stat span{font-size:11px;color:var(--muted)}
.bar-chart{height:230px;display:flex;align-items:flex-end;gap:10px;padding:10px 0 0}.bar-col{flex:1;height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:7px}.bar{width:min(34px,75%);background:linear-gradient(to top,var(--primary),#9b88ff);border-radius:7px 7px 2px 2px;min-height:3px}.bar-label{font-size:10px;color:var(--muted)}.bar-val{font-size:10px;color:#dce2ed}
.analytics-grid{grid-template-columns:1fr 1fr}.donut-wrap{display:flex;align-items:center;gap:25px}.donut{width:160px;height:160px;border-radius:50%;position:relative;background:conic-gradient(var(--primary) 0 40%,#35d39a 40% 70%,#f7c948 70% 88%,#ff647c 88% 100%)}.donut:after{content:"";position:absolute;inset:30px;border-radius:50%;background:#11182a}.donut-center{position:absolute;z-index:2;inset:0;display:grid;place-items:center;text-align:center}.donut-center strong{font-size:25px}.legend-list{display:grid;gap:12px;font-size:12px}.calendar-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:17px}.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:7px}.day-name{text-align:center;color:var(--muted);font-size:11px;padding:7px}.day{min-height:105px;border:1px solid var(--border);border-radius:11px;background:rgba(255,255,255,.025);padding:8px;cursor:pointer;transition:.2s}.day:hover,.day.selected{border-color:rgba(124,92,255,.65);background:rgba(124,92,255,.08)}.day.muted-day{opacity:.38}.day-num{font-size:12px;font-weight:800}.day.today .day-num{background:var(--primary);display:inline-grid;place-items:center;width:24px;height:24px;border-radius:7px}.event-dot{font-size:9px;margin-top:7px;padding:4px 5px;border-radius:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.event-pending{background:rgba(247,201,72,.1);color:#f7d65f}.event-completed{background:rgba(53,211,154,.1);color:#62ddb0}.event-overdue{background:rgba(255,100,124,.1);color:#ff8093}
.settings-grid{grid-template-columns:1fr 1fr}.setting{padding:20px}.setting h3{font-size:15px;margin-bottom:14px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.field{display:grid;gap:7px}.field label{font-size:11px;color:var(--muted);font-weight:700}.full{grid-column:1/-1}.modal-backdrop{position:fixed;inset:0;background:rgba(2,5,13,.7);backdrop-filter:blur(7px);display:none;align-items:center;justify-content:center;z-index:50;padding:20px}.modal-backdrop.show{display:flex}.modal{width:min(650px,100%);max-height:92vh;overflow:auto;background:#101729;border:1px solid var(--border);border-radius:20px;box-shadow:0 30px 90px rgba(0,0,0,.5);padding:23px}.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.modal-head h2{font-size:19px}.modal-actions{display:flex;justify-content:flex-end;gap:9px;margin-top:20px}.toast-box{position:fixed;right:20px;bottom:20px;z-index:100;display:grid;gap:8px}.toast{padding:12px 15px;border:1px solid var(--border);background:#141c30;border-radius:12px;box-shadow:var(--shadow);font-size:12px;animation:slide .25s ease}.toast.ok{border-left:3px solid var(--green)}.toast.err{border-left:3px solid var(--red)}@keyframes slide{from{transform:translateX(30px);opacity:0}to{transform:none;opacity:1}}
.auth{position:fixed;inset:0;display:none;place-items:center;background:radial-gradient(circle at 50% 20%,rgba(124,92,255,.22),transparent 35%),var(--bg);padding:20px;z-index:200}.auth.show{display:grid}.auth-card{width:min(430px,100%);padding:30px;background:rgba(16,23,41,.9);border:1px solid var(--border);border-radius:22px;box-shadow:var(--shadow)}.auth-logo{text-align:center;margin-bottom:24px}.auth-logo .logo-mark{margin:auto}.auth-logo h1{margin-top:12px;font-size:25px}.auth-logo p{color:var(--muted);font-size:12px;margin-top:5px}.auth-form{display:grid;gap:13px}.auth-switch{text-align:center;color:var(--muted);font-size:12px;margin-top:16px}.link{color:#a796ff;cursor:pointer;font-weight:700}.error{color:#ff7f91;font-size:11px;min-height:15px}.mobile-menu{display:none}
@media(max-width:1050px){.stats{grid-template-columns:repeat(3,1fr)}.subject-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:750px){
.sidebar{display:none}.main{margin:0;width:100%;padding:15px 14px 35px}.mobile-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}.mobile-menu{display:block;position:fixed;inset:0;background:rgba(3,6,14,.72);z-index:80}.mobile-menu.open{display:block}.mobile-nav{position:absolute;left:0;top:0;bottom:0;width:275px;background:#0c1222;padding:20px}.mobile-nav .nav{margin-top:30px}.mobile-close{float:right}.topbar{align-items:flex-start}.topbar h1{font-size:23px}.topbar .primary{padding:9px 11px;font-size:12px}.stats{grid-template-columns:repeat(2,1fr)}.dashboard-grid,.analytics-grid,.settings-grid,.subject-grid{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr}.full{grid-column:auto}.calendar-grid{gap:3px}.day{min-height:76px;padding:5px}.event-dot{font-size:8px}.progress-box{gap:15px}.ring{width:88px;height:88px}.ring:after{width:66px;height:66px}.section{padding:16px}
}
</style>
</head>
<body>

<div id="auth" class="auth show">
  <div class="auth-card">
    <div class="auth-logo">
      <div class="logo-mark">✓</div>
      <h1>STUDYFLOW</h1><p>Plan better. Study smarter.</p>
    </div>
    <div id="loginForm" class="auth-form">
      <div class="field"><label>Email</label><input id="loginEmail" class="input" type="email" placeholder="student@example.com"></div>
      <div class="field"><label>Password</label><input id="loginPass" class="input" type="password" placeholder="••••••••"></div>
      <div id="loginError" class="error"></div>
      <button class="primary" onclick="login()">Login</button>
      <div class="auth-switch">Don't have an account? <span class="link" onclick="showSignup()">Create one</span></div>
      <div class="auth-switch"><span class="link" onclick="showForgot()">Forgot password?</span></div>
    </div>
    <div id="signupForm" class="auth-form" style="display:none">
      <div class="field"><label>Full Name</label><input id="signupName" class="input" placeholder="Your name"></div>
      <div class="field"><label>Email</label><input id="signupEmail" class="input" type="email" placeholder="student@example.com"></div>
      <div class="field"><label>Password</label><input id="signupPass" class="input" type="password" placeholder="Minimum 6 characters"></div>
      <div id="signupError" class="error"></div>
      <button class="primary" onclick="signup()">Create Account</button>
      <div class="auth-switch">Already have an account? <span class="link" onclick="showLogin()">Login</span></div>
    </div>
    <div id="forgotForm" class="auth-form" style="display:none">
      <div class="field"><label>Email</label><input id="forgotEmail" class="input" type="email" placeholder="student@example.com"></div>
      <div id="forgotError" class="error"></div>
      <button class="primary" onclick="forgot()">Send Reset Link</button>
      <div class="auth-switch"><span class="link" onclick="showLogin()">Back to login</span></div>
    </div>
  </div>
</div>

<div id="app" class="app" style="display:none">
<aside class="sidebar">
  <div class="logo"><div class="logo-mark">✓</div> STUDYFLOW</div>
  <div class="tagline">Plan better. Study smarter.</div>
  <nav class="nav">
    <button data-page="dashboard" onclick="navigate('dashboard')"><span class="ico">⌂</span>Dashboard</button>
    <button data-page="tasks" onclick="navigate('tasks')"><span class="ico">✓</span>Tasks</button>
    <button data-page="calendar" onclick="navigate('calendar')"><span class="ico">▣</span>Calendar</button>
    <button data-page="subjects" onclick="navigate('subjects')"><span class="ico">▤</span>Subjects</button>
    <button data-page="analytics" onclick="navigate('analytics')"><span class="ico">◒</span>Analytics</button>
    <button data-page="settings" onclick="navigate('settings')"><span class="ico">⚙</span>Settings</button>
  </nav>
  <div class="side-bottom"><div class="user-mini"><div id="sideAvatar" class="avatar">S</div><div><b id="sideName">Student</b><small id="sideEmail">student</small></div></div></div>
</aside>

<div id="mobileMenu" class="mobile-menu">
  <div class="mobile-nav">
    <button class="icon-btn mobile-close" onclick="toggleMobile()">✕</button>
    <div class="logo"><div class="logo-mark">✓</div> STUDYFLOW</div>
    <nav class="nav">
      <button onclick="navigate('dashboard');toggleMobile()">⌂ Dashboard</button>
      <button onclick="navigate('tasks');toggleMobile()">✓ Tasks</button>
      <button onclick="navigate('calendar');toggleMobile()">▣ Calendar</button>
      <button onclick="navigate('subjects');toggleMobile()">▤ Subjects</button>
      <button onclick="navigate('analytics');toggleMobile()">◒ Analytics</button>
      <button onclick="navigate('settings');toggleMobile()">⚙ Settings</button>
    </nav>
  </div>
</div>

<main class="main">
  <div class="mobile-top"><button class="ghost" onclick="toggleMobile()">☰</button><b>STUDYFLOW</b><div id="mobileAvatar" class="avatar">S</div></div>

  <section id="dashboard" class="page active">
    <div class="topbar"><div><h1>Dashboard</h1><p id="welcome">Welcome back.</p></div><button class="primary" onclick="openTaskModal()">＋ Add Task</button></div>
    <div id="stats" class="grid stats"></div>
    <div class="grid dashboard-grid">
      <div class="card section"><div class="section-head"><h2>Today's Tasks</h2><span class="muted" id="todayLabel"></span></div><div id="todayTasks"></div></div>
      <div class="card section"><div class="section-head"><h2>Task Progress</h2></div><div class="progress-box"><div id="progressRing" class="ring"><span id="progressPct">0%</span></div><div class="legend"><div class="legend-row"><span><i class="dot" style="background:#7c5cff"></i>Completed</span><b id="legendCompleted">0</b></div><div class="legend-row"><span><i class="dot" style="background:#8e9ab0"></i>Pending</span><b id="legendPending">0</b></div><p class="muted" id="progressMessage">Start by adding your first task.</p></div></div></div>
    </div>
    <div class="grid dashboard-grid">
      <div class="card section"><div class="section-head"><h2>Upcoming Deadlines</h2><button class="icon-btn" onclick="navigate('tasks')">View all →</button></div><div id="upcoming"></div></div>
      <div class="card section"><div class="section-head"><h2>High Priority</h2></div><div id="highPriority"></div></div>
    </div>
  </section>

  <section id="tasks" class="page">
    <div class="topbar"><div><h1>Tasks</h1><p>Manage everything you need to get done.</p></div><button class="primary" onclick="openTaskModal()">＋ Add Task</button></div>
    <div class="card section">
      <div class="toolbar">
        <input id="taskSearch" class="input search" placeholder="Search title, subject or description..." oninput="renderTasks()">
        <select id="statusFilter" class="select" onchange="renderTasks()"><option>All</option><option>Pending</option><option>In Progress</option><option>Completed</option><option>Overdue</option></select>
        <select id="priorityFilter" class="select" onchange="renderTasks()"><option>All</option><option>High</option><option>Medium</option><option>Low</option></select>
        <select id="subjectFilter" class="select" onchange="renderTasks()"><option>All Subjects</option></select>
        <select id="sortFilter" class="select" onchange="renderTasks()"><option value="due">Due date</option><option value="priority">Priority</option><option value="created">Recently created</option></select>
      </div>
      <div id="taskTable"></div>
    </div>
  </section>

  <section id="calendar" class="page">
    <div class="topbar"><div><h1>Calendar</h1><p>See your academic deadlines at a glance.</p></div><button class="primary" onclick="openTaskModal()">＋ Add Task</button></div>
    <div class="card section"><div class="calendar-head"><button class="ghost" onclick="changeMonth(-1)">←</button><h2 id="monthTitle"></h2><button class="ghost" onclick="changeMonth(1)">→</button></div><div id="calendarGrid" class="calendar-grid"></div></div>
    <div id="selectedDateCard" class="card section" style="margin-top:15px"></div>
  </section>

  <section id="subjects" class="page">
    <div class="topbar"><div><h1>Subjects</h1><p>Organize your workload by subject.</p></div><button class="primary" onclick="openSubjectModal()">＋ Add Subject</button></div>
    <div id="subjectGrid" class="grid subject-grid"></div>
  </section>

  <section id="analytics" class="page">
    <div class="topbar"><div><h1>Analytics</h1><p>Understand your study productivity.</p></div></div>
    <div id="analyticsStats" class="grid stats"></div>
    <div class="grid analytics-grid" style="margin-top:15px">
      <div class="card section"><div class="section-head"><h2>Tasks Completed Per Week</h2></div><div id="weeklyChart" class="bar-chart"></div></div>
      <div class="card section"><div class="section-head"><h2>Tasks by Subject</h2></div><div id="subjectChart" class="bar-chart"></div></div>
    </div>
    <div class="grid analytics-grid" style="margin-top:15px">
      <div class="card section"><div class="section-head"><h2>Tasks by Priority</h2></div><div class="donut-wrap"><div id="priorityDonut" class="donut"><div class="donut-center"><strong id="donutTotal">0</strong></div></div><div id="priorityLegend" class="legend-list"></div></div></div>
      <div class="card section"><div class="section-head"><h2>Productivity Summary</h2></div><div id="summaryText" class="muted" style="line-height:1.8"></div></div>
    </div>
  </section>

  <section id="settings" class="page">
    <div class="topbar"><div><h1>Settings</h1><p>Manage your STUDYFLOW profile.</p></div></div>
    <div class="grid settings-grid">
      <div class="card setting"><h3>Profile</h3><div class="form-grid"><div class="field"><label>Student name</label><input id="profileName" class="input"></div><div class="field"><label>Email</label><input id="profileEmail" class="input" disabled></div></div><button class="primary" style="margin-top:16px" onclick="saveProfile()">Save Profile</button></div>
      <div class="card setting"><h3>Preferences</h3><p class="muted" style="margin-bottom:15px">This standalone version uses your browser's local storage. No server credentials are required.</p><button class="ghost" onclick="logout()">Log out</button><button class="ghost danger" style="margin-left:7px" onclick="clearAllData()">Reset my data</button></div>
    </div>
  </section>
</main>
</div>

<div id="taskModal" class="modal-backdrop">
<div class="modal"><div class="modal-head"><h2 id="taskModalTitle">Add Task</h2><button class="icon-btn" onclick="closeModal('taskModal')">✕</button></div>
<form id="taskForm" onsubmit="saveTask(event)"><input type="hidden" id="editTaskId">
<div class="form-grid">
<div class="field full"><label>Task Title *</label><input id="taskTitle" class="input" required placeholder="e.g. Complete linked list assignment"></div>
<div class="field full"><label>Description</label><textarea id="taskDescription" class="textarea" placeholder="What needs to be done?"></textarea></div>
<div class="field"><label>Subject *</label><select id="taskSubject" class="select" required></select></div>
<div class="field"><label>Priority</label><select id="taskPriority" class="select"><option>Low</option><option selected>Medium</option><option>High</option></select></div>
<div class="field"><label>Status</label><select id="taskStatus" class="select"><option>Pending</option><option>In Progress</option><option>Completed</option></select></div>
<div class="field"><label>Due Date *</label><input id="taskDueDate" class="input" type="date" required></div>
<div class="field"><label>Due Time</label><input id="taskDueTime" class="input" type="time"></div>
<div class="field full"><label>Notes</label><textarea id="taskNotes" class="textarea" placeholder="Optional notes"></textarea></div>
</div><div id="taskFormError" class="error" style="margin-top:10px"></div><div class="modal-actions"><button type="button" class="ghost" onclick="closeModal('taskModal')">Cancel</button><button class="primary">Save Task</button></div></form>
</div></div>

<div id="subjectModal" class="modal-backdrop"><div class="modal" style="max-width:450px"><div class="modal-head"><h2 id="subjectModalTitle">Add Subject</h2><button class="icon-btn" onclick="closeModal('subjectModal')">✕</button></div>
<form onsubmit="saveSubject(event)"><input type="hidden" id="editSubjectId"><div class="field"><label>Subject Name *</label><input id="subjectName" class="input" required placeholder="e.g. Data Structures"></div><div id="subjectError" class="error" style="margin-top:10px"></div><div class="modal-actions"><button type="button" class="ghost" onclick="closeModal('subjectModal')">Cancel</button><button class="primary">Save Subject</button></div></form>
</div></div>

<div id="toastBox" class="toast-box"></div>

<script>
const KEY='studyflow_single_file_v1';
let state={users:[],currentUser:null,tasks:[],subjects:[]};
let currentPage='dashboard', calDate=new Date(), selectedDate=fmtDate(new Date());

function load(){try{const x=JSON.parse(localStorage.getItem(KEY));if(x)state=x}catch(e){}}
function persist(){localStorage.setItem(KEY,JSON.stringify(state))}
function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,8)}
function fmtDate(d){let x=new Date(d);return `${x.getFullYear()}-${String(x.getMonth()+1).padStart(2,'0')}-${String(x.getDate()).padStart(2,'0')}`}
function today(){return fmtDate(new Date())}
function prettyDate(s){if(!s)return '—';return new Date(s+'T00:00:00').toLocaleDateString(undefined,{month:'short',day:'numeric',year:'numeric'})}
function getUser(){return state.users.find(u=>u.id===state.currentUser)}
function userTasks(){return state.tasks.filter(t=>t.user_id===state.currentUser)}
function userSubjects(){return state.subjects.filter(s=>s.user_id===state.currentUser)}
function isOverdue(t){return t.status!=='Completed' && today()>t.due_date}
function subName(id){return userSubjects().find(s=>s.id===id)?.name||'Unknown Subject'}
function initials(n){return (n||'S').split(' ').map(x=>x[0]).join('').slice(0,2).toUpperCase()}

function saveState(){persist();renderAll()}
function toast(msg,type='ok'){const el=document.createElement('div');el.className='toast '+type;el.textContent=msg;document.getElementById('toastBox').appendChild(el);setTimeout(()=>el.remove(),2800)}
function closeModal(id){document.getElementById(id).classList.remove('show')}
function openModal(id){document.getElementById(id).classList.add('show')}

function showLogin(){loginForm.style.display='grid';signupForm.style.display='none';forgotForm.style.display='none'}
function showSignup(){loginForm.style.display='none';signupForm.style.display='grid';forgotForm.style.display='none'}
function showForgot(){loginForm.style.display='none';signupForm.style.display='none';forgotForm.style.display='grid'}
function signup(){
 const name=signupName.value.trim(),email=signupEmail.value.trim().toLowerCase(),pass=signupPass.value;
 signupError.textContent='';
 if(!name||!email||pass.length<6){signupError.textContent='Enter a name, valid email and password of at least 6 characters.';return}
 if(state.users.some(u=>u.email===email)){signupError.textContent='An account with this email already exists.';return}
 const u={id:uid(),name,email,pass};state.users.push(u);state.currentUser=u.id;persist();enterApp();toast('Account created successfully');
}
function login(){
 const email=loginEmail.value.trim().toLowerCase(),pass=loginPass.value;
 const u=state.users.find(x=>x.email===email&&x.pass===pass);loginError.textContent='';
 if(!u){loginError.textContent='Invalid email or password.';return}
 state.currentUser=u.id;persist();enterApp();toast('Welcome back!');
}
function forgot(){if(!forgotEmail.value.trim()){forgotError.textContent='Enter your email.';return}forgotError.textContent='';toast('Demo reset link sent. Check your email inbox.')}
function enterApp(){auth.classList.remove('show');app.style.display='flex';renderAll()}
function logout(){state.currentUser=null;persist();app.style.display='none';auth.classList.add('show');showLogin();loginPass.value='';toast('Logged out')}
function clearAllData(){if(confirm('Delete all your tasks and subjects?')){state.tasks=state.tasks.filter(t=>t.user_id!==state.currentUser);state.subjects=state.subjects.filter(s=>s.user_id!==state.currentUser);saveState();toast('Your data was reset')}}

function navigate(p){currentPage=p;document.querySelectorAll('.page').forEach(x=>x.classList.toggle('active',x.id===p));document.querySelectorAll('.sidebar .nav button').forEach(x=>x.classList.toggle('active',x.dataset.page===p));renderAll()}
function toggleMobile(){mobileMenu.classList.toggle('open')}
function renderHeader(){const u=getUser();if(!u)return;sideName.textContent=u.name;sideEmail.textContent=u.email;sideAvatar.textContent=initials(u.name);mobileAvatar.textContent=initials(u.name);welcome.textContent=`Good to see you, ${u.name.split(' ')[0]}. Keep the momentum going.`;profileName.value=u.name;profileEmail.value=u.email;todayLabel.textContent=new Date().toLocaleDateString(undefined,{weekday:'long',month:'short',day:'numeric'})}

function renderStats(){
 const ts=userTasks(), pending=ts.filter(t=>t.status==='Pending').length, progress=ts.filter(t=>t.status==='In Progress').length, complete=ts.filter(t=>t.status==='Completed').length, overdue=ts.filter(isOverdue).length;
 const items=[['Total Tasks',ts.length,'▦'],['Pending',pending,'◷'],['In Progress',progress,'◌'],['Completed',complete,'✓'],['Overdue',overdue,'!']];
 stats.innerHTML=items.map(x=>`<div class="card stat"><div class="stat-top"><span>${x[0]}</span><span class="stat-icon">${x[2]}</span></div><div class="stat-num">${x[1]}</div></div>`).join('');
 const pct=ts.length?Math.round(complete/ts.length*100):0;progressPct.textContent=pct+'%';progressRing.style.background=`conic-gradient(var(--primary) ${pct*3.6}deg,rgba(255,255,255,.07) 0deg)`;legendCompleted.textContent=complete;legendPending.textContent=ts.length-complete;progressMessage.textContent=ts.length?`Good progress! You have ${ts.length-complete} tasks remaining.`:'Start by adding your first task.'
}
function taskMini(t){const cls=t.status==='Completed'?'completed':isOverdue(t)?'overdue':t.status==='In Progress'?'progress':'status';return `<div class="task-item"><div class="task-left"><div class="task-title">${esc(t.title)}</div><div class="task-sub">${esc(subName(t.subject_id))} · ${prettyDate(t.due_date)}${t.due_time?' · '+t.due_time:''}</div></div><span class="badge ${cls}">${isOverdue(t)?'Overdue':t.status}</span></div>`}
function renderDashboard(){
 const ts=userTasks();let td=ts.filter(t=>t.due_date===today()).sort((a,b)=>(a.due_time||'').localeCompare(b.due_time||''));todayTasks.innerHTML=td.length?td.map(taskMini).join(''):`<div class="empty"><div class="empty-icon">✓</div><h3>No tasks today</h3><p>Enjoy the clear schedule or add a task.</p></div>`;
 let up=ts.filter(t=>t.status!=='Completed'&&!isOverdue(t)&&t.due_date>=today()).sort((a,b)=>a.due_date.localeCompare(b.due_date)).slice(0,5);upcoming.innerHTML=up.length?up.map(taskMini).join(''):`<div class="empty"><h3>No upcoming deadlines</h3><p>You're all caught up.</p></div>`;
 let hp=ts.filter(t=>t.priority==='High'&&t.status!=='Completed').sort((a,b)=>a.due_date.localeCompare(b.due_date)).slice(0,5);highPriority.innerHTML=hp.length?hp.map(t=>`<div class="task-item"><div class="task-left"><div class="task-title">${esc(t.title)}</div><div class="task-sub">${esc(subName(t.subject_id))} · ${prettyDate(t.due_date)}</div></div><span class="badge high">High</span></div>`).join(''):`<div class="empty"><h3>No high-priority tasks</h3><p>Nice work.</p></div>`;
}
function renderTasks(){
 const q=(taskSearch.value||'').toLowerCase(), sf=statusFilter.value,pf=priorityFilter.value,sub=subjectFilter.value,sort=sortFilter.value;
 let ts=userTasks().filter(t=>(t.title+' '+subName(t.subject_id)+' '+(t.description||'')).toLowerCase().includes(q));
 if(sf==='Overdue')ts=ts.filter(isOverdue);else if(sf!=='All')ts=ts.filter(t=>t.status===sf);
 if(pf!=='All')ts=ts.filter(t=>t.priority===pf);if(sub!=='All Subjects')ts=ts.filter(t=>subName(t.subject_id)===sub);
 const po={High:0,Medium:1,Low:2};if(sort==='due')ts.sort((a,b)=>(a.due_date+' '+(a.due_time||'')).localeCompare(b.due_date+' '+(b.due_time||'')));if(sort==='priority')ts.sort((a,b)=>po[a.priority]-po[b.priority]);if(sort==='created')ts.sort((a,b)=>b.created_at-a.created_at);
 if(!ts.length){taskTable.innerHTML=`<div class="empty"><div class="empty-icon">📚</div><h3>No tasks found</h3><p>Add a task or adjust your search and filters.</p><button class="primary" style="margin-top:14px" onclick="openTaskModal()">＋ Add Task</button></div>`;return}
 taskTable.innerHTML=`<div class="table-wrap"><table class="task-table"><thead><tr><th>Task</th><th>Subject</th><th>Priority</th><th>Status</th><th>Due</th><th>Actions</th></tr></thead><tbody>${ts.map(t=>`<tr style="${t.status==='Completed'?'opacity:.62':''}"><td><b>${esc(t.title)}</b><div class="task-sub">${esc(t.description||'')}</div></td><td>${esc(subName(t.subject_id))}</td><td><span class="badge ${t.priority.toLowerCase()}">${t.priority}</span></td><td><span class="badge ${t.status==='Completed'?'completed':isOverdue(t)?'overdue':t.status==='In Progress'?'progress':'status'}">${isOverdue(t)?'Overdue':t.status}</span></td><td>${prettyDate(t.due_date)}${t.due_time?'<br><span class="muted">'+t.due_time+'</span>':''}</td><td><div class="actions"><button class="icon-btn" title="Edit" onclick="openTaskModal('${t.id}')">✎</button>${t.status!=='Completed'?`<button class="icon-btn" title="Complete" onclick="completeTask('${t.id}')">✓</button>`:''}<button class="icon-btn danger" title="Delete" onclick="deleteTask('${t.id}')">⌫</button></div></td></tr>`).join('')}</tbody></table></div>`;
}
function populateSubjectFilters(){
 const subs=userSubjects(), cur=subjectFilter.value;subjectFilter.innerHTML='<option>All Subjects</option>'+subs.map(s=>`<option>${esc(s.name)}</option>`).join('');if([...subjectFilter.options].some(o=>o.text===cur))subjectFilter.value=cur;
 taskSubject.innerHTML=subs.map(s=>`<option value="${s.id}">${esc(s.name)}</option>`).join('');
}
function openTaskModal(id=''){
 populateSubjectFilters();taskFormError.textContent='';editTaskId.value=id;taskModalTitle.textContent=id?'Edit Task':'Add Task';
 if(id){const t=state.tasks.find(x=>x.id===id);taskTitle.value=t.title;taskDescription.value=t.description||'';taskSubject.value=t.subject_id;taskPriority.value=t.priority;taskStatus.value=t.status;taskDueDate.value=t.due_date;taskDueTime.value=t.due_time||'';taskNotes.value=t.notes||''}
 else{taskForm.reset();taskPriority.value='Medium';taskStatus.value='Pending';taskDueDate.value=today();if(userSubjects().length)taskSubject.value=userSubjects()[0].id}
 if(!userSubjects().length){closeModal('taskModal');toast('Add a subject before creating a task','err');navigate('subjects');return}openModal('taskModal')
}
function saveTask(e){e.preventDefault();const title=taskTitle.value.trim(),subject=taskSubject.value,date=taskDueDate.value;if(!title||!subject||!date){taskFormError.textContent='Title, subject and due date are required.';return}
 const id=editTaskId.value;const obj={title,description:taskDescription.value.trim(),subject_id:subject,priority:taskPriority.value,status:taskStatus.value,due_date:date,due_time:taskDueTime.value,notes:taskNotes.value.trim(),updated_at:Date.now()};
 if(id){const t=state.tasks.find(x=>x.id===id);Object.assign(t,obj);toast('Task updated')}else{state.tasks.push({id:uid(),user_id:state.currentUser,created_at:Date.now(),...obj});toast('Task added')}
 persist();closeModal('taskModal');renderAll()
}
function completeTask(id){const t=state.tasks.find(x=>x.id===id);t.status='Completed';t.updated_at=Date.now();persist();toast('Task completed');renderAll()}
function deleteTask(id){if(!confirm('Delete this task?'))return;state.tasks=state.tasks.filter(t=>t.id!==id);persist();toast('Task deleted');renderAll()}

function renderSubjects(){
 const subs=userSubjects(),ts=userTasks();if(!subs.length){subjectGrid.innerHTML=`<div class="card empty" style="grid-column:1/-1"><div class="empty-icon">📚</div><h3>No subjects added yet.</h3><p>Add your subjects to organize your study tasks.</p><button class="primary" style="margin-top:14px" onclick="openSubjectModal()">＋ Add Subject</button></div>`;return}
 subjectGrid.innerHTML=subs.map(s=>{const a=ts.filter(t=>t.subject_id===s.id),c=a.filter(t=>t.status==='Completed').length,p=a.length-c;return `<div class="card subject-card"><div class="subject-title"><h3>${esc(s.name)}</h3><div><button class="icon-btn" onclick="openSubjectModal('${s.id}')">✎</button><button class="icon-btn danger" onclick="deleteSubject('${s.id}')">⌫</button></div></div><div class="subject-stats"><div class="subject-stat"><strong>${a.length}</strong><span>Total</span></div><div class="subject-stat"><strong>${c}</strong><span>Completed</span></div><div class="subject-stat"><strong>${p}</strong><span>Pending</span></div></div><div style="height:6px;background:rgba(255,255,255,.06);border-radius:5px"><div style="height:100%;width:${a.length?c/a.length*100:0}%;background:var(--primary);border-radius:5px"></div></div></div>`}).join('')
}
function openSubjectModal(id=''){editSubjectId.value=id;subjectModalTitle.textContent=id?'Edit Subject':'Add Subject';subjectError.textContent='';subjectName.value=id?userSubjects().find(s=>s.id===id).name:'';openModal('subjectModal')}
function saveSubject(e){e.preventDefault();const name=subjectName.value.trim();if(!name){subjectError.textContent='Subject name is required.';return}const id=editSubjectId.value;if(userSubjects().some(s=>s.name.toLowerCase()===name.toLowerCase()&&s.id!==id)){subjectError.textContent='That subject already exists.';return}
 if(id){state.subjects.find(s=>s.id===id).name=name;toast('Subject updated')}else{state.subjects.push({id:uid(),user_id:state.currentUser,name,created_at:Date.now()});toast('Subject added')}persist();closeModal('subjectModal');renderAll()}
function deleteSubject(id){const count=userTasks().filter(t=>t.subject_id===id).length;if(count&&!confirm(`This subject has ${count} task(s). Delete the subject anyway? Its tasks will remain without a valid subject.`))return;if(!count&&!confirm('Delete this subject?'))return;state.subjects=state.subjects.filter(s=>s.id!==id);persist();toast('Subject deleted');renderAll()}

function changeMonth(n){calDate.setMonth(calDate.getMonth()+n);renderCalendar()}
function renderCalendar(){
 const y=calDate.getFullYear(),m=calDate.getMonth(),first=new Date(y,m,1),last=new Date(y,m+1,0),start=first.getDay(),days=last.getDate(),prev=new Date(y,m,0).getDate(),ts=userTasks();
 monthTitle.textContent=calDate.toLocaleDateString(undefined,{month:'long',year:'numeric'});
 let h=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(x=>`<div class="day-name">${x}</div>`).join('');
 for(let i=0;i<42;i++){let d=i-start+1,yy=y,mm=m;if(d<1){d=prev+d;mm=m-1}else if(d>days){d=d-days;mm=m+1}const ds=fmtDate(new Date(yy,mm,d)),outside=mm!==m, dayTasks=ts.filter(t=>t.due_date===ds).slice(0,3);h+=`<div class="day ${outside?'muted-day':''} ${ds===today()?'today':''} ${ds===selectedDate?'selected':''}" onclick="selectDate('${ds}')"><div class="day-num">${d}</div>${dayTasks.map(t=>`<div class="event-dot ${t.status==='Completed'?'event-completed':isOverdue(t)?'event-overdue':'event-pending'}">${esc(t.title)}</div>`).join('')}${ts.filter(t=>t.due_date===ds).length>3?`<div class="muted" style="margin-top:4px">+${ts.filter(t=>t.due_date===ds).length-3} more</div>`:''}</div>`}
 calendarGrid.innerHTML=h;renderSelectedDate()
}
function selectDate(d){selectedDate=d;renderCalendar()}
function renderSelectedDate(){const ts=userTasks().filter(t=>t.due_date===selectedDate);selectedDateCard.innerHTML=`<div class="section-head"><div><h2>${prettyDate(selectedDate)}</h2><span class="muted">${ts.length} task${ts.length===1?'':'s'} due</span></div><button class="ghost" onclick="openTaskModal()">＋ Task</button></div>${ts.length?ts.map(taskMini).join(''):`<div class="empty" style="padding:25px"><h3>No tasks on this date</h3><p>Your schedule is clear.</p></div>`}`}

function renderAnalytics(){
 const ts=userTasks(),subs=userSubjects(),complete=ts.filter(t=>t.status==='Completed').length,pending=ts.length-complete,over=ts.filter(isOverdue).length,pct=ts.length?Math.round(complete/ts.length*100):0;
 analyticsStats.innerHTML=[['Total Tasks',ts.length,'▦'],['Completed',complete,'✓'],['Pending',pending,'◷'],['Overdue',over,'!'],['Completion',pct+'%','◒']].map(x=>`<div class="card stat"><div class="stat-top"><span>${x[0]}</span><span class="stat-icon">${x[2]}</span></div><div class="stat-num">${x[1]}</div></div>`).join('');
 const weeks=[];for(let i=5;i>=0;i--){let end=new Date();end.setDate(end.getDate()-i*7);let start=new Date(end);start.setDate(end.getDate()-6);let c=ts.filter(t=>t.status==='Completed'&&t.updated_at>=start.setHours(0,0,0,0)&&t.updated_at<=new Date(end).setHours(23,59,59,999)).length;weeks.push({label:i===0?'Now':start.toLocaleDateString(undefined,{month:'short',day:'numeric'}),v:c})}
 weeklyChart.innerHTML=weeks.map(w=>`<div class="bar-col"><span class="bar-val">${w.v}</span><div class="bar" style="height:${Math.max(3,w.v/(Math.max(...weeks.map(x=>x.v),1))*170)}px"></div><span class="bar-label">${w.label}</span></div>`).join('');
 const vals=subs.map(s=>({name:s.name,v:ts.filter(t=>t.subject_id===s.id).length})).filter(x=>x.v);subjectChart.innerHTML=vals.length?vals.map(x=>`<div class="bar-col"><span class="bar-val">${x.v}</span><div class="bar" style="height:${Math.max(3,x.v/(Math.max(...vals.map(y=>y.v),1))*170)}px"></div><span class="bar-label">${esc(x.name).slice(0,12)}</span></div>`).join(''):`<div class="empty" style="width:100%">No subject data yet.</div>`;
 const p={High:ts.filter(t=>t.priority==='High').length,Medium:ts.filter(t=>t.priority==='Medium').length,Low:ts.filter(t=>t.priority==='Low').length},total=ts.length||1,a=p.High/total*100,b=(p.High+p.Medium)/total*100;
 priorityDonut.style.background=`conic-gradient(#ff647c 0 ${a}%,#f7c948 ${a}% ${b}%,#35d39a ${b}% 100%)`;donutTotal.textContent=ts.length;priorityLegend.innerHTML=[['High',p.High,'#ff647c'],['Medium',p.Medium,'#f7c948'],['Low',p.Low,'#35d39a']].map(x=>`<div><i class="dot" style="background:${x[2]}"></i>${x[0]} <b style="float:right">${x[1]}</b></div>`).join('');
 summaryText.innerHTML=ts.length?`You have completed <b>${complete}</b> of <b>${ts.length}</b> tasks (${pct}%).<br><br>${over?`<b>${over}</b> task${over>1?'s are':' is'} overdue. Consider tackling ${over>1?'them':'it'} next.`:'No overdue tasks — your deadlines are under control.'}<br><br>Keep building a consistent study routine by reviewing your upcoming deadlines each day.`:`No analytics yet. Add tasks to start tracking your productivity.`
}
function saveProfile(){const u=getUser(),n=profileName.value.trim();if(!n){toast('Name cannot be empty','err');return}u.name=n;persist();renderAll();toast('Profile updated')}
function esc(s){return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}

function renderAll(){if(!state.currentUser)return;renderHeader();renderStats();renderDashboard();populateSubjectFilters();renderTasks();renderSubjects();renderCalendar();renderAnalytics()}
load();
if(state.currentUser&&state.users.some(u=>u.id===state.currentUser))enterApp();
else {app.style.display='none';auth.classList.add('show')}
</script>
</body>
</html>